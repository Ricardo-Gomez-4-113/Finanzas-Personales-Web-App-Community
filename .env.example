# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA FINANZAS PERSONALES
# Copia este archivo a .env y define tus propios valores secretos:
# cp .env.example .env
# ==============================================================================

# Clave secreta para firma criptográfica de tokens JWT de sesión (requerido)
JWT_SECRET_KEY=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios

# ------------------------------------------------------------------------------
# SERVICIO DE ENVÍO DE CORREOS (Recuperación de contraseñas y notificaciones)
# ------------------------------------------------------------------------------

# Opción 1: API de Correo Transaccional (Resend o compatible)
RESEND_API_KEY=tu_api_key_aqui
RESEND_FROM=Finanzas Personales <no-responder@tu-dominio.com>

# Opción 2: Servidor SMTP estándar (Gmail, Brevo, SendGrid, etc. como fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM=Finanzas Personales <tu_correo@gmail.com>

# ------------------------------------------------------------------------------
# SEGURIDAD Y HARDENING
# ------------------------------------------------------------------------------
# Control de Swagger UI (/docs) y OpenAPI (/openapi.json). Por defecto deshabilitado (false)
ENABLE_DOCS=false


# Asistente con LLM y su bot de Telegram (opcional). Ver CLAUDE.md, sección asistente/.
# GEMINI_API_KEY: clave de Google AI Studio. La capa gratuita puede usar lo que se le manda para mejorar sus modelos: solo datos de prueba.
GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN: lo da @BotFather al crear el bot. TELEGRAM_BOT_USERNAME: el nombre del bot sin @ (sale en el enlace del QR).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ASISTENTE_SECRETO_INTERNO: secreto (32 caracteres o más) que comparten la app y el bot para su API interna. Genéralo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ASISTENTE_SECRETO_INTERNO=
