# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO PARA FINANZAS PERSONALES
# Copia este archivo a .env y define tus propios valores secretos:
# cp .env.example .env
# ==============================================================================

# Clave secreta para firma criptográfica de tokens JWT de sesión (requerido)
JWT_SECRET_KEY=tu_clave_secreta_jwt_de_al_menos_32_caracteres_aleatorios

# ------------------------------------------------------------------------------
# SERVICIO DE ENVÍO DE CORREOS (Recuperación de contraseñas y notificaciones)
# ------------------------------------------------------------------------------

# Opción 1: API de Correo Transaccional (Resend o compatible)
RESEND_API_KEY=tu_api_key_aqui
RESEND_FROM=Finanzas Personales <no-responder@tu-dominio.com>

# Opción 2: Servidor SMTP estándar (Gmail, Brevo, SendGrid, etc. como fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contrasena_de_aplicacion_16_caracteres
SMTP_FROM=Finanzas Personales <tu_correo@gmail.com>

# ------------------------------------------------------------------------------
# SEGURIDAD Y HARDENING
# ------------------------------------------------------------------------------
# Control de Swagger UI (/docs) y OpenAPI (/openapi.json). Por defecto deshabilitado (false)
ENABLE_DOCS=false


# Asistente con LLM y su bot de Telegram (opcional). Ver CLAUDE.md, sección asistente/.
# GEMINI_API_KEY: clave de Google AI Studio. La capa gratuita puede usar lo que se le manda para mejorar sus modelos: solo datos de prueba.
GEMINI_API_KEY=
# TELEGRAM_BOT_TOKEN: lo da @BotFather al crear el bot. TELEGRAM_BOT_USERNAME: el nombre del bot sin @ (sale en el enlace del QR).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# ASISTENTE_SECRETO_INTERNO: secreto (32 caracteres o más) que comparten la app y el bot para su API interna. Genéralo con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ASISTENTE_SECRETO_INTERNO=

# Topes diarios del asistente por cuenta (los lee la app; valores por defecto abajo; vacío = por defecto, 0 o negativo no los apaga)
# ASISTENTE_MAX_MENSAJES_DIA=100
# ASISTENTE_MAX_TOKENS_DIA=200000
# ASISTENTE_MAX_MEDIOS_DIA=20

# Asistente web: secreto propio, DISTINTO de ASISTENTE_SECRETO_INTERNO (el de Telegram). Mínimo 32 caracteres.
# ASISTENTE_WEB_SECRETO=

# Modelo del asistente: `gemini` (por defecto, necesita GEMINI_API_KEY) u `ollama` (un modelo propio en la red, sin cuota ni costo: sirve para
# desarrollar). ASISTENTE_MODELO_RESPALDO es opcional: el otro proveedor, que se prueba una vez si el principal falla o no puede con el mensaje
# (un modelo de solo texto no lee fotos ni audios).
# ASISTENTE_MODELO=ollama
# ASISTENTE_MODELO_RESPALDO=gemini
# OLLAMA_URL=http://IP-DEL-SERVIDOR:11435      # con o sin /api o /v1 al final (red local o Tailscale)
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_NUM_CTX=8192                          # ventana de contexto; las instrucciones y herramientas ocupan ~4000 tokens
# OLLAMA_TIMEOUT=50
# OLLAMA_PERMITIR_HTTP=1                       # solo si de verdad necesitas http:// hacia una IP pública (no recomendado)
# OLLAMA_API_KEY=                              # solo si hay un proxy delante; Ollama no la pide
